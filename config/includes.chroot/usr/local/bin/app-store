#!/usr/bin/env python3
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css, titled_label

class Store(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.AppStore")

    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="App Store")
        win.set_default_size(920, 590)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        root.set_margin_top(24)
        root.set_margin_bottom(24)
        root.set_margin_start(28)
        root.set_margin_end(28)

        root.append(titled_label("App Store", "Discover apps for Orchard."))

        for name, desc in [
            ("Firefox", "Web browser"),
            ("VLC", "Video and audio player"),
            ("GIMP", "Image editor"),
        ]:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            title = Gtk.Label(label=name, xalign=0)
            title.set_markup(f"<b>{name}</b>")
            sub = Gtk.Label(label=desc, xalign=0)
            info.append(title)
            info.append(sub)
            row.append(info)
            row.append(Gtk.Button(label="Install"))
            root.append(row)

        win.set_child(root)
        win.present()

Store().run()
