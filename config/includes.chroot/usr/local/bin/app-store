#!/usr/bin/env python3
import sys, subprocess, shutil
sys.path.insert(0,'/usr/lib/orchard')
import gi
gi.require_version('Gtk','4.0')
from gi.repository import Gtk, GLib
from ui import apply_css, window, page_title
APPS=[
 ('Firefox','Web browser','apt','firefox-esr'),
 ('VLC','Video and audio player','apt','vlc'),
 ('GIMP','Image editor','apt','gimp'),
 ('LibreOffice','Office suite','apt','libreoffice'),
 ('Transmission','BitTorrent client','apt','transmission-gtk'),
 ('Firefox (Flatpak)','Sandboxed Firefox','flatpak','org.mozilla.firefox'),
 ('VLC (Flatpak)','Sandboxed VLC','flatpak','org.videolan.VLC'),
 ('GIMP (Flatpak)','Sandboxed GIMP','flatpak','org.gimp.GIMP')]
class Store(Gtk.Application):
    def __init__(self): super().__init__(application_id='org.orchard.AppStore')
    def do_activate(self):
        apply_css(); self.win=window(self,'App Store',900,650); outer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14); outer.set_margin_top(22); outer.set_margin_bottom(22); outer.set_margin_start(24); outer.set_margin_end(24); outer.append(page_title('App Store','Simple software installation using Debian packages and Flatpak.'))
        search=Gtk.SearchEntry(placeholder_text='Search apps'); search.connect('search-changed',self.filter); outer.append(search)
        self.list=Gtk.ListBox(); self.list.set_selection_mode(Gtk.SelectionMode.NONE); scroll=Gtk.ScrolledWindow(); scroll.set_vexpand(True); scroll.set_child(self.list); outer.append(scroll)
        self.rows=[]
        for name,desc,kind,pkg in APPS:
            row=Gtk.ListBoxRow(); row.search=(name+' '+desc).lower(); card=Gtk.Box(spacing=14); card.add_css_class('card'); card.set_margin_bottom(8); text=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=3); text.set_hexpand(True); a=Gtk.Label(label=name,xalign=0); a.set_markup(f'<b>{GLib.markup_escape_text(name)}</b>'); text.append(a); d=Gtk.Label(label=desc,xalign=0); d.add_css_class('muted'); text.append(d); source=Gtk.Label(label='Debian' if kind=='apt' else 'Flatpak',xalign=0); source.add_css_class('muted'); text.append(source); card.append(text)
            b=Gtk.Button(label='Install'); b.add_css_class('suggested-action'); b.connect('clicked',self.install,kind,pkg,b); card.append(b); row.set_child(card); self.list.append(row); self.rows.append(row)
        self.win.set_child(outer); self.win.present()
    def filter(self,e):
        q=e.get_text().strip().lower()
        for r in self.rows: r.set_visible(not q or q in r.search)
    def install(self,b,kind,pkg,button):
        button.set_sensitive(False); button.set_label('Working…')
        if kind=='apt': cmd=['pkexec','/usr/local/lib/orchard/appstore-helper','apt',pkg]
        else: cmd=['/usr/local/lib/orchard/appstore-helper','flatpak',pkg]
        subprocess.Popen(cmd).wait(); button.set_label('Done'); button.set_sensitive(True)
Store().run(None)
