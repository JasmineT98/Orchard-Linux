#!/usr/bin/env python3
import sys, datetime
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib
from orchard.ui import install_css

class Clock(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.Clock")
        self.time = None; self.elapsed = 0; self.running = False; self.stopwatch = None
    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Clock")
        win.set_default_size(520, 430)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        root.set_margin_top(30); root.set_margin_bottom(30)
        root.set_margin_start(30); root.set_margin_end(30)
        self.time = Gtk.Label()
        self.time.add_css_class("orchard-title")
        root.append(self.time)
        self.stopwatch = Gtk.Label(label="00:00.0")
        root.append(self.stopwatch)
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        start = Gtk.Button(label="Start / Pause"); start.connect("clicked", self.toggle)
        reset = Gtk.Button(label="Reset"); reset.connect("clicked", self.reset)
        controls.append(start); controls.append(reset); root.append(controls)
        win.set_child(root); win.present()
        self.tick(); GLib.timeout_add(100, self.tick)
    def toggle(self, *_): self.running = not self.running
    def reset(self, *_): self.elapsed = 0; self.running = False
    def tick(self):
        self.time.set_text(datetime.datetime.now().strftime("%I:%M:%S %p"))
        if self.running: self.elapsed += 0.1
        m = int(self.elapsed // 60); s = self.elapsed - m*60
        self.stopwatch.set_text(f"{m:02d}:{s:04.1f}")
        return True
Clock().run(sys.argv)
