#!/usr/bin/env python3
import sys
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css

class Calculator(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.Calculator")
        self.expr = ""
        self.entry = None

    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Calculator")
        win.set_default_size(340, 450)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        root.set_margin_top(14); root.set_margin_bottom(14)
        root.set_margin_start(14); root.set_margin_end(14)
        self.entry = Gtk.Entry()
        self.entry.set_alignment(1.0)
        root.append(self.entry)

        grid = Gtk.Grid(column_spacing=6, row_spacing=6)
        keys = ["AC","±","%","÷","7","8","9","×","4","5","6","−","1","2","3","+","0",".","="]
        for i, key in enumerate(keys):
            b = Gtk.Button(label=key)
            b.connect("clicked", lambda _b, k=key: self.press(k))
            if key == "=":
                grid.attach(b, 2, 4, 2, 1)
            elif key == "0":
                grid.attach(b, 0, 4, 2, 1)
            elif key == ".":
                grid.attach(b, 2, 4, 1, 1)
            else:
                row = i // 4
                col = i % 4
                if i < 16:
                    grid.attach(b, col, row, 1, 1)
        root.append(grid)
        win.set_child(root)
        win.present()

    def press(self, k):
        if k == "AC":
            self.expr = ""
        elif k == "±":
            self.expr = f"-({self.expr})" if self.expr else "-"
        elif k == "%":
            self.expr += "/100"
        elif k == "=":
            try:
                safe = self.expr.replace("×","*").replace("÷","/").replace("−","-")
                self.expr = str(eval(safe, {"__builtins__": {}}, {}))
            except Exception:
                self.expr = "Error"
        else:
            if self.expr == "Error":
                self.expr = ""
            self.expr += k
        self.entry.set_text(self.expr)

Calculator().run(sys.argv)
