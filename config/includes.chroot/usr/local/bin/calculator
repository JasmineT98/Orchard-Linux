#!/usr/bin/env python3
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css

class Calculator(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.Calculator")

    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Calculator")
        win.set_default_size(330, 430)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(14)
        box.set_margin_bottom(14)
        box.set_margin_start(14)
        box.set_margin_end(14)

        entry = Gtk.Entry()
        entry.set_alignment(1.0)
        box.append(entry)

        expr = {"text": ""}
        grid = Gtk.Grid(column_spacing=6, row_spacing=6)
        keys = ["7","8","9","÷","4","5","6","×","1","2","3","−","0",".","=","+"]

        def press(label):
            if label == "=":
                try:
                    safe = expr["text"].replace("×","*").replace("÷","/").replace("−","-")
                    value = str(eval(safe, {"__builtins__": {}}, {}))
                    expr["text"] = value
                except Exception:
                    expr["text"] = "Error"
            else:
                if expr["text"] == "Error":
                    expr["text"] = ""
                expr["text"] += label
            entry.set_text(expr["text"])

        for i, key in enumerate(keys):
            b = Gtk.Button(label=key)
            b.connect("clicked", lambda _b, k=key: press(k))
            grid.attach(b, i % 4, i // 4, 1, 1)

        box.append(grid)
        win.set_child(box)
        win.present()

Calculator().run()
