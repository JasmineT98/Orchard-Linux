#!/usr/bin/env python3
import sys
import subprocess
from pathlib import Path
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import (
    install_css, load_settings, set_setting, file_picker,
    reboot_shell, restart_wallpaper, spawn, titled_label
)

class Settings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.Settings")
        self.stack = None
        self.win = None

    def page_box(self, title, subtitle):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_margin_top(22)
        box.set_margin_bottom(22)
        box.set_margin_start(24)
        box.set_margin_end(24)
        box.append(titled_label(title, subtitle))
        return box

    def action_button(self, label, command):
        b = Gtk.Button(label=label)
        b.connect("clicked", lambda *_: spawn(command))
        return b

    def do_activate(self):
        install_css()
        self.win = Gtk.ApplicationWindow(application=self, title="Settings")
        self.win.set_default_size(940, 630)

        shell = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)

        sidebar = Gtk.ListBox()
        sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        sidebar.set_size_request(215, -1)

        categories = [
            ("Appearance", "appearance"),
            ("Wi‑Fi", "wifi"),
            ("Bluetooth", "bluetooth"),
            ("Sound", "sound"),
            ("Displays", "displays"),
            ("Power", "power"),
            ("Storage", "storage"),
            ("Keyboard", "keyboard"),
            ("Notifications", "notifications"),
            ("Software Update", "updates"),
            ("About Orchard", "about"),
        ]

        self.stack = Gtk.Stack()
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)

        for label, name in categories:
            row = Gtk.ListBoxRow()
            row.page_name = name
            row.set_child(Gtk.Label(label=label, xalign=0))
            sidebar.append(row)

        sidebar.connect("row-selected", self.select_page)

        # Appearance
        p = self.page_box("Appearance", "Orchard look and desktop behavior")
        settings = load_settings()

        appearance = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        light = Gtk.Button(label="Light")
        dark = Gtk.Button(label="Dark")
        light.connect("clicked", lambda *_: self.set_appearance("light"))
        dark.connect("clicked", lambda *_: self.set_appearance("dark"))
        appearance.append(light); appearance.append(dark)
        p.append(appearance)

        wallpaper = Gtk.Button(label="Choose Desktop Wallpaper…")
        wallpaper.connect("clicked", self.choose_wallpaper, False)
        p.append(wallpaper)

        lockwall = Gtk.Button(label="Choose Lock Screen Wallpaper…")
        lockwall.connect("clicked", self.choose_wallpaper, True)
        p.append(lockwall)

        dock_switch = Gtk.Switch(active=bool(settings.get("dock_visible", True)))
        dockrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        dockrow.append(Gtk.Label(label="Show Dock", xalign=0, hexpand=True))
        dockrow.append(dock_switch)
        dock_switch.connect("notify::active", self.toggle_dock)
        p.append(dockrow)

        gap_switch = Gtk.Switch(active=int(settings.get("window_gap", 8)) > 0)
        gaprow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        gaprow.append(Gtk.Label(label="Tiled windows have margins", xalign=0, hexpand=True))
        gaprow.append(gap_switch)
        gap_switch.connect("notify::active", self.toggle_gap)
        p.append(gaprow)
        self.stack.add_named(p, "appearance")

        # Wi-Fi
        p = self.page_box("Wi‑Fi", "Wireless network controls")
        p.append(self.action_button("Open Wi‑Fi Networks", ["/usr/local/bin/wifi-settings"]))
        self.stack.add_named(p, "wifi")

        # Bluetooth
        p = self.page_box("Bluetooth", "Pair and manage Bluetooth devices")
        p.append(self.action_button("Open Bluetooth Devices", ["/usr/bin/blueman-manager"]))
        self.stack.add_named(p, "bluetooth")

        # Sound
        p = self.page_box("Sound", "Output, input and application volume")
        p.append(self.action_button("Open Sound Controls", ["/usr/bin/pavucontrol"]))
        self.stack.add_named(p, "sound")

        # Displays
        p = self.page_box("Displays", "Resolution, scale and arrangement")
        p.append(self.action_button("Open Display Settings", ["/usr/bin/wdisplays"]))
        self.stack.add_named(p, "displays")

        # Power
        p = self.page_box("Power", "Battery and power management")
        p.append(self.action_button("Open Power Settings", ["/usr/bin/xfce4-power-manager-settings"]))
        self.stack.add_named(p, "power")

        # Storage
        p = self.page_box("Storage", "Disks, partitions and removable media")
        p.append(self.action_button("Open Disk Utility", ["/usr/bin/gnome-disks"]))
        self.stack.add_named(p, "storage")

        # Keyboard
        p = self.page_box("Keyboard", "Command / Windows Key / Search Key shortcuts")
        shortcuts = [
            "Command / Windows / Search + Space     Search",
            "Command / Windows / Search + Tab       Switch apps",
            "Command / Windows / Search + Q         Quit current window",
            "Command / Windows / Search + W         Close current window",
            "Command / Windows / Search + M         Minimize",
            "Command / Windows / Search + L         Lock screen",
            "Command / Windows / Search + ,         Settings",
            "Command / Windows / Search + Shift + 3 Full screenshot",
            "Command / Windows / Search + Shift + 4 Area screenshot",
        ]
        for line in shortcuts:
            p.append(Gtk.Label(label=line, xalign=0))
        self.stack.add_named(p, "keyboard")

        # Notifications
        p = self.page_box("Notifications", "Recent notifications and calendar")
        p.append(self.action_button("Open Notification Center", ["/usr/local/bin/orchard-notification-center"]))
        self.stack.add_named(p, "notifications")

        # Updates
        p = self.page_box("Software Update", "Check Orchard and system packages")
        p.append(self.action_button("Open Software Update", ["/usr/local/bin/software-update"]))
        self.stack.add_named(p, "updates")

        # About
        p = self.page_box("About Orchard", "Hardware and operating system information")
        p.append(self.action_button("System Information", ["/usr/local/bin/system-info"]))
        p.append(self.action_button("Activity Monitor", ["/usr/local/bin/activity-monitor"]))
        p.append(self.action_button("Recovery", ["/usr/local/bin/orchard-recovery"]))
        self.stack.add_named(p, "about")

        scroll = Gtk.ScrolledWindow()
        scroll.set_child(sidebar)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        shell.append(scroll)
        shell.append(self.stack)

        self.win.set_child(shell)
        self.win.present()
        sidebar.select_row(sidebar.get_row_at_index(0))

    def select_page(self, _box, row):
        if row:
            self.stack.set_visible_child_name(row.page_name)

    def set_appearance(self, mode):
        set_setting("appearance", mode)
        reboot_shell()
        self.win.close()
        spawn(["/usr/local/bin/settings"])

    def choose_wallpaper(self, _button, lock):
        path = file_picker("Choose Lock Screen Wallpaper" if lock else "Choose Desktop Wallpaper")
        if not path:
            return
        set_setting("lock_wallpaper" if lock else "wallpaper", path)
        if not lock:
            restart_wallpaper()

    def toggle_dock(self, switch, _pspec):
        set_setting("dock_visible", switch.get_active())
        reboot_shell()

    def toggle_gap(self, switch, _pspec):
        gap = 8 if switch.get_active() else 0
        set_setting("window_gap", gap)
        spawn(["/usr/local/bin/orchard-set-gap", str(gap)])

Settings().run(sys.argv)
