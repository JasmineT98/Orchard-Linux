#!/usr/bin/env python3
import sys, os, subprocess
from pathlib import Path
sys.path.insert(0, '/usr/lib/orchard')
import gi
gi.require_version('Gtk','4.0')
from gi.repository import Gtk, Gio
from ui import apply_css, window, page_title

class Settings(Gtk.Application):
    def __init__(self): super().__init__(application_id='org.orchard.Settings')
    def do_activate(self):
        apply_css(); w=window(self,'Settings',880,600)
        split=Gtk.Paned.new(Gtk.Orientation.HORIZONTAL); split.set_position(210)
        sidebar=Gtk.ListBox(); sidebar.add_css_class('sidebar'); sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        stack=Gtk.Stack(); stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        pages=[('Appearance',self.appearance()),('Network',self.simple('Network','Use the network menu in the top bar or Network Connections to configure Wi-Fi and Ethernet.','nm-connection-editor')),
               ('Bluetooth',self.simple('Bluetooth','Bluetooth is provided by BlueZ and the lightweight Blueman control panel.','blueman-manager')),
               ('Sound',self.simple('Sound','PipeWire and WirePlumber provide the audio stack.','pavucontrol')),
               ('Power',self.power()),('About',self.about())]
        for name,page in pages:
            row=Gtk.ListBoxRow(); row.set_child(Gtk.Label(label=name,xalign=0)); row.page_name=name; sidebar.append(row); stack.add_named(page,name)
        def changed(lb,row):
            if row: stack.set_visible_child_name(row.page_name)
        sidebar.connect('row-selected',changed); sidebar.select_row(sidebar.get_row_at_index(0))
        split.set_start_child(sidebar); split.set_end_child(stack); split.set_resize_start_child(False); split.set_shrink_start_child(False)
        w.set_child(split); w.present()
    def wrapper(self,title,sub):
        outer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=18); outer.set_margin_top(24); outer.set_margin_bottom(24); outer.set_margin_start(28); outer.set_margin_end(28); outer.append(page_title(title,sub)); return outer
    def appearance(self):
        outer=self.wrapper('Appearance','Choose the system appearance used by built-in apps and compatible third-party applications.')
        card=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14); card.add_css_class('card')
        dark=Gtk.Switch(active=Path.home().joinpath('.config/orchard/dark').exists())
        row=Gtk.Box(spacing=12); row.append(Gtk.Label(label='Dark appearance',hexpand=True,xalign=0)); row.append(dark); card.append(row)
        reduce=Gtk.Switch(active=False); row2=Gtk.Box(spacing=12); row2.append(Gtk.Label(label='Reduce motion',hexpand=True,xalign=0)); row2.append(reduce); card.append(row2)
        note=Gtk.Label(label='B1 applies appearance changes to newly opened applications. Full live theme propagation is planned for the next build.',xalign=0); note.set_wrap(True); note.add_css_class('muted'); card.append(note)
        def toggle(sw,_):
            d=Path.home()/'.config/orchard'; d.mkdir(parents=True,exist_ok=True); flag=d/'dark'
            if sw.get_active(): flag.touch()
            else: flag.unlink(missing_ok=True)
            subprocess.run(['/usr/local/bin/apply-appearance'],check=False)
        dark.connect('notify::active',lambda sw,*_: toggle(sw,None)); outer.append(card); return outer
    def simple(self,title,text,cmd):
        outer=self.wrapper(title,text); b=Gtk.Button(label=f'Open {title} Controls'); b.add_css_class('suggested-action'); b.set_halign(Gtk.Align.START); b.connect('clicked',lambda *_: subprocess.Popen([cmd])); outer.append(b); return outer
    def power(self):
        outer=self.wrapper('Power','B1 uses conservative defaults suitable for older laptops and enables compressed swap through ZRAM.')
        card=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8); card.add_css_class('card')
        for text in ['ZRAM: enabled','Idle background services: minimized','Display brightness: hardware controlled','Low-spec detection: automatic']:
            card.append(Gtk.Label(label=text,xalign=0))
        outer.append(card); return outer
    def about(self):
        outer=self.wrapper('About','System information')
        card=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8); card.add_css_class('card')
        for text in ['Orchard Linux B1','Debian 13 Stable (trixie)','Wayland / Labwc','Unified GTK + Qt compatibility layer']:
            card.append(Gtk.Label(label=text,xalign=0))
        outer.append(card); return outer
Settings().run(None)
