#!/usr/bin/env python3
import sys
from pathlib import Path
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib
from orchard.ui import install_css

PATH = Path.home() / ".local" / "share" / "orchard" / "notes.txt"

class Notes(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.Notes")
        self.pending = 0

    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Notes")
        win.set_default_size(760, 560)
        view = Gtk.TextView()
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.set_left_margin(20); view.set_right_margin(20)
        view.set_top_margin(20); view.set_bottom_margin(20)
        buf = view.get_buffer()
        try:
            buf.set_text(PATH.read_text())
        except Exception:
            pass
        buf.connect("changed", self.changed, buf)
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(view)
        win.set_child(scroll)
        win.present()

    def changed(self, _buf, buf):
        if self.pending:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(600, self.save, buf)

    def save(self, buf):
        PATH.parent.mkdir(parents=True, exist_ok=True)
        text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True)
        PATH.write_text(text)
        self.pending = 0
        return False

Notes().run(sys.argv)
