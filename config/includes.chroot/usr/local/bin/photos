#!/usr/bin/env python3
import sys
from pathlib import Path
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css, spawn, titled_label

class Photos(Gtk.Application):
    def __init__(self): super().__init__(application_id="org.orchard.Photos")
    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Photos")
        win.set_default_size(880, 600)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(20); root.set_margin_bottom(20)
        root.set_margin_start(22); root.set_margin_end(22)
        root.append(titled_label("Photos", "Pictures on this computer"))
        flow = Gtk.FlowBox(); flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(5); flow.set_row_spacing(10); flow.set_column_spacing(10)
        folder = Path.home() / "Pictures"
        folder.mkdir(parents=True, exist_ok=True)
        for p in sorted(folder.iterdir()):
            if p.suffix.lower() not in {".png",".jpg",".jpeg",".webp",".gif"}: continue
            b = Gtk.Button()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            pic = Gtk.Picture.new_for_filename(str(p))
            pic.set_content_fit(Gtk.ContentFit.COVER); pic.set_size_request(135, 105)
            box.append(pic); box.append(Gtk.Label(label=p.name, ellipsize=3))
            b.set_child(box); b.connect("clicked", lambda _b, f=str(p): spawn(["/usr/bin/xdg-open", f]))
            flow.append(b)
        scroll = Gtk.ScrolledWindow(); scroll.set_vexpand(True); scroll.set_child(flow)
        root.append(scroll); win.set_child(root); win.present()
Photos().run(sys.argv)
