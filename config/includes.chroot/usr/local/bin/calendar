#!/usr/bin/env python3
import sys
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css, titled_label
class Calendar(Gtk.Application):
    def __init__(self): super().__init__(application_id="org.orchard.Calendar")
    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Calendar")
        win.set_default_size(620, 520)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_margin_top(22); root.set_margin_bottom(22)
        root.set_margin_start(24); root.set_margin_end(24)
        root.append(titled_label("Calendar", "Your month at a glance"))
        root.append(Gtk.Calendar())
        win.set_child(root); win.present()
Calendar().run(sys.argv)
