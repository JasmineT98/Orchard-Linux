#!/usr/bin/env python3
import sys
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css, spawn, titled_label

class Recovery(Gtk.Application):
    def __init__(self): super().__init__(application_id="org.orchard.Recovery")
    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Orchard Recovery")
        win.set_default_size(560, 430)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(22); root.set_margin_bottom(22)
        root.set_margin_start(24); root.set_margin_end(24)
        root.append(titled_label("Recovery", "Repair the visible desktop without using a terminal"))
        actions = [
            ("Restart Orchard Shell", ["/usr/bin/systemctl","--user","restart","orchard-shell.service"]),
            ("Restart Wallpaper", ["/usr/bin/systemctl","--user","restart","orchard-wallpaper.service"]),
            ("Open Wi‑Fi", ["/usr/local/bin/wifi-settings"]),
            ("Open Settings", ["/usr/local/bin/settings"]),
            ("Restart Computer", ["/usr/bin/systemctl","reboot"]),
        ]
        for label, cmd in actions:
            b = Gtk.Button(label=label); b.connect("clicked", lambda _b, c=cmd: spawn(c)); root.append(b)
        win.set_child(root); win.present()
Recovery().run(sys.argv)
