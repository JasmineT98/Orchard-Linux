#!/usr/bin/env python3
import sys
import re
import subprocess

import ctypes
import ctypes.util
lib = ctypes.util.find_library("gtk4-layer-shell")
if lib:
    ctypes.CDLL(lib, mode=ctypes.RTLD_GLOBAL)

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, GLib, Gtk4LayerShell as LayerShell

from orchard.ui import install_css, spawn, card

def run(cmd):
    return subprocess.run(cmd, text=True, capture_output=True)

class ControlCenter(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.ControlCenter")

    def do_activate(self):
        install_css("""
        window { background: rgba(35,35,40,0.96); color: white; }
        .orchard-card { background: rgba(255,255,255,0.08); }
        """)
        win = Gtk.ApplicationWindow(application=self)
        win.set_decorated(False)
        win.set_default_size(370, 520)
        LayerShell.init_for_window(win)
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(win, LayerShell.Edge.RIGHT, True)
        LayerShell.set_margin(win, LayerShell.Edge.TOP, 35)
        LayerShell.set_margin(win, LayerShell.Edge.RIGHT, 8)
        try:
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)
        except Exception:
            pass

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(14)
        root.set_margin_bottom(14)
        root.set_margin_start(14)
        root.set_margin_end(14)

        tiles = Gtk.Grid(column_spacing=10, row_spacing=10)

        wifi = Gtk.Button(label="Wi‑Fi")
        wifi.connect("clicked", lambda *_: spawn(["/usr/local/bin/wifi-settings"]))
        tiles.attach(wifi, 0, 0, 1, 1)

        bt = Gtk.Button(label="Bluetooth")
        bt.connect("clicked", lambda *_: spawn(["/usr/bin/blueman-manager"]))
        tiles.attach(bt, 1, 0, 1, 1)

        display = Gtk.Button(label="Displays")
        display.connect("clicked", lambda *_: spawn(["/usr/bin/wdisplays"]))
        tiles.attach(display, 0, 1, 1, 1)

        focus = Gtk.Button(label="Settings")
        focus.connect("clicked", lambda *_: spawn(["/usr/local/bin/settings"]))
        tiles.attach(focus, 1, 1, 1, 1)

        root.append(tiles)

        vol_card = card()
        vol_card.append(Gtk.Label(label="Sound", xalign=0))
        volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        cp = run(["/usr/bin/wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        m = re.search(r"([0-9]+(?:\.[0-9]+)?)", cp.stdout)
        if m:
            volume.set_value(float(m.group(1)) * 100)
        volume.connect(
            "value-changed",
            lambda s: run(["/usr/bin/wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{s.get_value()/100:.2f}"])
        )
        vol_card.append(volume)
        root.append(vol_card)

        bright_card = card()
        bright_card.append(Gtk.Label(label="Display Brightness", xalign=0))
        bright = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 1)
        cp = run(["/usr/bin/brightnessctl", "-m"])
        m = re.search(r",(\d+)%,", cp.stdout)
        bright.set_value(float(m.group(1)) if m else 60)
        bright.connect(
            "value-changed",
            lambda s: run(["/usr/bin/brightnessctl", "set", f"{int(s.get_value())}%"])
        )
        bright_card.append(bright)
        root.append(bright_card)

        lock = Gtk.Button(label="Lock Screen")
        lock.connect("clicked", lambda *_: (spawn(["/usr/local/bin/orchard-lock"]), win.close()))
        root.append(lock)

        win.set_child(root)
        win.present()

ControlCenter().run(sys.argv)
