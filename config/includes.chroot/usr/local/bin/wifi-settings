#!/usr/bin/env python3
import sys
import subprocess
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib
from orchard.ui import install_css, titled_label

def nmcli(args):
    try:
        cp = subprocess.run(["/usr/bin/nmcli", *args], text=True, capture_output=True, timeout=12)
        return cp.returncode, cp.stdout.strip(), cp.stderr.strip()
    except Exception as e:
        return 1, "", str(e)

class WifiSettings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.Wifi")
        self.listbox = None
        self.status = None
        self.win = None

    def do_activate(self):
        install_css()
        self.win = Gtk.ApplicationWindow(application=self, title="Wi‑Fi")
        self.win.set_default_size(650, 560)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_margin_top(22)
        root.set_margin_bottom(22)
        root.set_margin_start(24)
        root.set_margin_end(24)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head.append(titled_label("Wi‑Fi", "Choose a wireless network"))
        refresh = Gtk.Button(label="Refresh")
        refresh.connect("clicked", lambda *_: self.refresh())
        head.append(refresh)
        root.append(head)

        self.status = Gtk.Label(xalign=0)
        self.status.set_wrap(True)
        root.append(self.status)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(self.listbox)
        root.append(scroll)

        self.win.set_child(root)
        self.win.present()
        GLib.idle_add(self.refresh)

    def clear(self):
        child = self.listbox.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.listbox.remove(child)
            child = nxt

    def refresh(self):
        self.clear()
        self.status.set_text("Scanning for networks…")
        nmcli(["radio", "wifi", "on"])
        rc, out, err = nmcli([
            "-t", "--escape", "no",
            "-f", "IN-USE,SSID,SIGNAL,SECURITY",
            "device", "wifi", "list", "--rescan", "yes"
        ])
        if rc != 0:
            self.status.set_text("Wi‑Fi is not available on this system yet.")
            l = Gtk.Label(label=err or "No wireless adapter was reported.", xalign=0)
            l.set_wrap(True)
            self.listbox.append(l)
            return False

        seen = set()
        rows = []
        for line in out.splitlines():
            parts = line.split(":")
            if len(parts) < 4:
                continue
            inuse, ssid, signal = parts[0], parts[1], parts[2]
            security = ":".join(parts[3:])
            ssid = ssid.strip()
            if not ssid or ssid in seen:
                continue
            seen.add(ssid)
            rows.append((inuse == "*", ssid, signal, security))

        rows.sort(key=lambda x: (not x[0], -(int(x[2]) if x[2].isdigit() else 0)))
        active = next((r[1] for r in rows if r[0]), None)
        self.status.set_text(f"Connected to {active}" if active else "Not connected")

        if not rows:
            self.listbox.append(Gtk.Label(label="No networks found.", xalign=0))
            return False

        for connected, ssid, signal, security in rows:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.set_margin_top(8)
            row.set_margin_bottom(8)
            row.set_margin_start(8)
            row.set_margin_end(8)

            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name = Gtk.Label(xalign=0)
            name.set_markup(f"<b>{GLib.markup_escape_text(ssid)}</b>")
            detail = Gtk.Label(
                label=f"Signal {signal}%  •  {'Secured' if security and security != '--' else 'Open'}",
                xalign=0,
            )
            info.append(name)
            info.append(detail)
            row.append(info)

            button = Gtk.Button(label="Connected" if connected else "Connect")
            button.set_sensitive(not connected)
            if not connected:
                button.connect("clicked", self.connect_clicked, ssid, security)
            row.append(button)

            holder = Gtk.ListBoxRow()
            holder.set_child(row)
            self.listbox.append(holder)
        return False

    def connect_clicked(self, _button, ssid, security):
        if not security or security == "--":
            self.connect_network(ssid, None)
            return

        dialog = Gtk.Dialog(title=f"Join {ssid}", transient_for=self.win, modal=True)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Join", Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(10)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        box.set_margin_start(16)
        box.set_margin_end(16)

        box.append(Gtk.Label(label=f"Enter the password for “{ssid}”.", xalign=0))
        password = Gtk.PasswordEntry()
        password.set_show_peek_icon(True)
        box.append(password)

        dialog.connect("response", self.password_response, ssid, password)
        dialog.present()

    def password_response(self, dialog, response, ssid, entry):
        pw = entry.get_text()
        dialog.close()
        if response == Gtk.ResponseType.OK:
            self.connect_network(ssid, pw)

    def connect_network(self, ssid, password):
        self.status.set_text(f"Connecting to {ssid}…")
        args = ["device", "wifi", "connect", ssid]
        if password:
            args += ["password", password]
        rc, _out, err = nmcli(args)
        if rc == 0:
            self.status.set_text(f"Connected to {ssid}")
            GLib.timeout_add(900, self.refresh)
        else:
            self.status.set_text(err or f"Could not connect to {ssid}.")

WifiSettings().run(sys.argv)
