#!/usr/bin/env python3
import sys, subprocess
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib
from orchard.ui import install_css, titled_label

class Activity(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.ActivityMonitor")
        self.listbox = None
    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Activity Monitor")
        win.set_default_size(820, 600)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(18); root.set_margin_bottom(18)
        root.set_margin_start(20); root.set_margin_end(20)
        root.append(titled_label("Activity Monitor", "Running processes"))
        self.listbox = Gtk.ListBox()
        scroll = Gtk.ScrolledWindow(); scroll.set_vexpand(True); scroll.set_child(self.listbox)
        root.append(scroll); win.set_child(root); win.present()
        self.refresh(); GLib.timeout_add_seconds(3, self.refresh)
    def refresh(self):
        child = self.listbox.get_first_child()
        while child:
            nxt = child.get_next_sibling(); self.listbox.remove(child); child = nxt
        cp = subprocess.run(
            ["/bin/ps","-eo","pid,comm,%cpu,%mem","--sort=-%cpu"],
            text=True, capture_output=True
        )
        for line in cp.stdout.splitlines()[:45]:
            self.listbox.append(Gtk.Label(label=line, xalign=0))
        return True
Activity().run(sys.argv)
