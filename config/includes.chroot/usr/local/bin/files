#!/usr/bin/env python3
import sys, os, subprocess
from pathlib import Path
sys.path.insert(0,'/usr/lib/orchard')
import gi
gi.require_version('Gtk','4.0')
from gi.repository import Gtk, Gio
from ui import apply_css, window
class Files(Gtk.Application):
    def __init__(self): super().__init__(application_id='org.orchard.Files'); self.path=Path.home()
    def do_activate(self):
        apply_css(); self.win=window(self,'Files',900,600)
        root=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8); root.set_margin_top(10); root.set_margin_bottom(12); root.set_margin_start(12); root.set_margin_end(12)
        bar=Gtk.Box(spacing=8); back=Gtk.Button(label='‹'); back.connect('clicked',self.go_parent); self.loc=Gtk.Entry(); self.loc.set_hexpand(True); self.loc.set_text(str(self.path)); self.loc.connect('activate',self.go_typed); bar.append(back); bar.append(self.loc); root.append(bar)
        self.list=Gtk.ListBox(); self.list.add_css_class('card'); self.list.connect('row-activated',self.open_row); scroll=Gtk.ScrolledWindow(); scroll.set_vexpand(True); scroll.set_child(self.list); root.append(scroll)
        self.win.set_child(root); self.refresh(); self.win.present()
    def refresh(self):
        while (c:=self.list.get_first_child()) is not None: self.list.remove(c)
        self.loc.set_text(str(self.path))
        try: entries=sorted(self.path.iterdir(), key=lambda p:(not p.is_dir(),p.name.lower()))
        except Exception: entries=[]
        for p in entries:
            if p.name.startswith('.'): continue
            row=Gtk.ListBoxRow(); row.path=p; box=Gtk.Box(spacing=12); box.set_margin_top(8); box.set_margin_bottom(8); box.set_margin_start(10); box.set_margin_end(10)
            icon=Gtk.Label(label='📁' if p.is_dir() else '📄'); box.append(icon); name=Gtk.Label(label=p.name,xalign=0); name.set_hexpand(True); box.append(name); row.set_child(box); self.list.append(row)
    def open_row(self,lb,row):
        p=row.path
        if p.is_dir(): self.path=p; self.refresh()
        else: subprocess.Popen(['xdg-open',str(p)])
    def go_parent(self,*_): self.path=self.path.parent; self.refresh()
    def go_typed(self,e):
        p=Path(e.get_text()).expanduser()
        if p.is_dir(): self.path=p; self.refresh()
Files().run(None)
