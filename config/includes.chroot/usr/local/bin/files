#!/usr/bin/env python3
import gi
import os
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css, titled_label

class Files(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.Files")

    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Files")
        win.set_default_size(900, 580)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(20)
        root.set_margin_bottom(20)
        root.set_margin_start(20)
        root.set_margin_end(20)

        home = os.path.expanduser("~")
        root.append(titled_label("Files", home))

        store = Gtk.StringList()
        try:
            names = sorted(os.listdir(home), key=str.lower)
        except OSError:
            names = []

        for name in names:
            store.append(name)

        factory = Gtk.SignalListItemFactory()
        factory.connect("setup", lambda f, item: item.set_child(Gtk.Label(xalign=0)))
        factory.connect(
            "bind",
            lambda f, item: item.get_child().set_text(item.get_item().get_string())
        )

        view = Gtk.ListView(model=Gtk.NoSelection(model=store), factory=factory)
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(view)
        root.append(scroll)

        win.set_child(root)
        win.present()

Files().run()
