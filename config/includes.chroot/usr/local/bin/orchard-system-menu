#!/usr/bin/env python3
import sys

import ctypes
import ctypes.util
lib = ctypes.util.find_library("gtk4-layer-shell")
if lib:
    ctypes.CDLL(lib, mode=ctypes.RTLD_GLOBAL)

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, GLib, Gtk4LayerShell as LayerShell

from orchard.ui import install_css, spawn

class SystemMenu(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.SystemMenu")

    def do_activate(self):
        install_css("""
        window { background: rgba(35,35,40,0.96); color: white; }
        button { padding: 10px 14px; }
        """)
        win = Gtk.ApplicationWindow(application=self)
        win.set_decorated(False)
        win.set_default_size(285, 365)
        LayerShell.init_for_window(win)
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(win, LayerShell.Edge.LEFT, True)
        LayerShell.set_margin(win, LayerShell.Edge.TOP, 35)
        LayerShell.set_margin(win, LayerShell.Edge.LEFT, 7)
        try:
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)
        except Exception:
            pass

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(10)
        box.set_margin_end(10)

        actions = [
            ("About Orchard", ["/usr/local/bin/system-info"]),
            ("System Settings…", ["/usr/local/bin/settings"]),
            ("App Store…", ["/usr/local/bin/app-store"]),
            ("Lock Screen", ["/usr/local/bin/orchard-lock"]),
            ("Sleep", ["/usr/bin/systemctl", "suspend"]),
            ("Restart…", ["/usr/bin/systemctl", "reboot"]),
            ("Shut Down…", ["/usr/bin/systemctl", "poweroff"]),
        ]
        for label, cmd in actions:
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, c=cmd: (spawn(c), win.close()))
            box.append(b)

        win.set_child(box)
        win.present()

SystemMenu().run(sys.argv)
