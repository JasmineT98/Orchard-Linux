#!/usr/bin/env python3
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css

class Editor(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.TextEditor")

    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Text Editor")
        win.set_default_size(800, 560)

        view = Gtk.TextView()
        view.set_left_margin(20)
        view.set_right_margin(20)
        view.set_top_margin(20)
        view.set_bottom_margin(20)

        scroll = Gtk.ScrolledWindow()
        scroll.set_child(view)
        win.set_child(scroll)
        win.present()

Editor().run()
