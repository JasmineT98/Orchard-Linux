#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0,'/usr/lib/orchard')
import gi
gi.require_version('Gtk','4.0')
from gi.repository import Gtk
from ui import apply_css, window
class Editor(Gtk.Application):
    def __init__(self): super().__init__(application_id='org.orchard.TextEditor'); self.file=None
    def do_activate(self):
        apply_css(); self.win=window(self,'Text Editor',820,620)
        box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8); box.set_margin_top(8); box.set_margin_bottom(8); box.set_margin_start(8); box.set_margin_end(8)
        actions=Gtk.Box(spacing=8); op=Gtk.Button(label='Open'); sv=Gtk.Button(label='Save'); op.connect('clicked',self.open_dialog); sv.connect('clicked',self.save_dialog); actions.append(op); actions.append(sv); box.append(actions)
        self.view=Gtk.TextView(); self.view.set_monospace(True); self.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR); scroll=Gtk.ScrolledWindow(); scroll.set_vexpand(True); scroll.set_child(self.view); box.append(scroll); self.win.set_child(box); self.win.present()
    def open_dialog(self,*_):
        d=Gtk.FileDialog(); d.open(self.win,None,self.open_done)
    def open_done(self,d,res):
        try:
            f=d.open_finish(res); self.file=Path(f.get_path()); self.view.get_buffer().set_text(self.file.read_text(errors='replace'))
        except Exception: pass
    def save_dialog(self,*_):
        if self.file: self.write(self.file); return
        d=Gtk.FileDialog(); d.save(self.win,None,self.save_done)
    def save_done(self,d,res):
        try: self.file=Path(d.save_finish(res).get_path()); self.write(self.file)
        except Exception: pass
    def write(self,p):
        b=self.view.get_buffer(); p.write_text(b.get_text(b.get_start_iter(),b.get_end_iter(),True))
Editor().run(None)
