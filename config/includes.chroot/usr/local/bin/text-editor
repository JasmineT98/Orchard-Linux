#!/usr/bin/env python3
import sys
from pathlib import Path
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk
from orchard.ui import install_css, file_picker

class Editor(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.orchard.TextEditor")
        self.path = Path(sys.argv[1]) if len(sys.argv) > 1 else None
        self.buf = None

    def do_activate(self):
        install_css()
        win = Gtk.ApplicationWindow(application=self, title="Text Editor")
        win.set_default_size(820, 600)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        toolbar.set_margin_top(8); toolbar.set_margin_start(8); toolbar.set_margin_end(8)
        save = Gtk.Button(label="Save")
        save.connect("clicked", self.save)
        openb = Gtk.Button(label="Open…")
        openb.connect("clicked", self.open_file)
        toolbar.append(openb); toolbar.append(save)
        root.append(toolbar)

        view = Gtk.TextView()
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.set_left_margin(18); view.set_right_margin(18)
        view.set_top_margin(18); view.set_bottom_margin(18)
        self.buf = view.get_buffer()
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(view)
        root.append(scroll)

        win.set_child(root)
        win.present()
        if self.path and self.path.exists():
            self.buf.set_text(self.path.read_text(errors="replace"))

    def open_file(self, *_):
        p = file_picker("Open Text File")
        if p:
            self.path = Path(p)
            try:
                self.buf.set_text(self.path.read_text(errors="replace"))
            except Exception:
                pass

    def save(self, *_):
        if not self.path:
            p = file_picker("Save Text File", save=True)
            if not p:
                return
            self.path = Path(p)
        text = self.buf.get_text(self.buf.get_start_iter(), self.buf.get_end_iter(), True)
        self.path.write_text(text)

Editor().run(sys.argv)
