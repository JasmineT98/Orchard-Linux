<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>8</gap>
  </core>
  <theme>
    <name>Orchard</name>
    <cornerRadius>10</cornerRadius>
    <titlebar><layout>close:iconify,max</layout><showTitle>yes</showTitle></titlebar>
    <dropShadows>yes</dropShadows>
    <keepBorder>yes</keepBorder>
  </theme>
  <keyboard>
    <default />
    <keybind key="W-space"><action name="Execute" command="wofi --show drun" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-l"><action name="Execute" command="loginctl lock-session" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
  </keyboard>
</labwc_config>
