<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>8</gap>
  </core>

  <theme>
    <name>Orchard</name>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
    <keepBorder>yes</keepBorder>
  </theme>

  <keyboard>
    <default />

    <keybind key="W-space">
      <action name="Execute" command="wofi --show drun --prompt Search" />
    </keybind>

    <keybind key="W-Tab">
      <action name="NextWindow" />
    </keybind>

    <keybind key="W-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <keybind key="W-w">
      <action name="Close" />
    </keybind>

    <keybind key="W-l">
      <action name="Execute" command="loginctl lock-session" />
    </keybind>

    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>

    <keybind key="W-S-3">
      <action name="Execute" command="orchard-screenshot-full" />
    </keybind>

    <keybind key="W-S-4">
      <action name="Execute" command="orchard-screenshot-area" />
    </keybind>

    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +10%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 10%-" />
    </keybind>
  </keyboard>
</labwc_config>
