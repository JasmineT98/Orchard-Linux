[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": [
      "custom/logo",
      "custom/apps"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "network",
      "pulseaudio",
      "battery",
      "custom/control"
    ],
    "custom/logo": {
      "format": "\u25cf",
      "tooltip": "Applications",
      "on-click": "wofi --show drun"
    },
    "custom/apps": {
      "format": "Applications",
      "on-click": "wofi --show drun"
    },
    "clock": {
      "format": "{:%a %b %d  %I:%M %p}",
      "tooltip-format": "{:%A, %B %d, %Y}"
    },
    "network": {
      "format-wifi": "\uf1eb",
      "format-ethernet": "\udb80\ude00",
      "format-disconnected": "\udb81\uddaa",
      "tooltip-format": "{ifname}: {ipaddr}"
    },
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "\udb81\udd81",
      "format-icons": {
        "default": [
          "\uf026",
          "\uf027",
          "\uf028"
        ]
      },
      "on-click": "pavucontrol"
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": [
        "\uf244",
        "\uf243",
        "\uf242",
        "\uf241",
        "\uf240"
      ]
    },
    "custom/control": {
      "format": "\u2699",
      "tooltip": "Settings",
      "on-click": "settings"
    }
  },
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 58,
    "margin-bottom": 8,
    "margin-left": 160,
    "margin-right": 160,
    "spacing": 10,
    "modules-center": [
      "custom/files",
      "custom/browser",
      "custom/editor",
      "custom/store",
      "custom/settings",
      "custom/terminal"
    ],
    "custom/files": {
      "format": "\uf07b",
      "tooltip": "Files",
      "on-click": "files"
    },
    "custom/browser": {
      "format": "\uf269",
      "tooltip": "Web Browser",
      "on-click": "firefox-esr || xdg-open https://www.debian.org"
    },
    "custom/editor": {
      "format": "\uf044",
      "tooltip": "Text Editor",
      "on-click": "text-editor"
    },
    "custom/store": {
      "format": "\uf290",
      "tooltip": "App Store",
      "on-click": "app-store"
    },
    "custom/settings": {
      "format": "\uf013",
      "tooltip": "Settings",
      "on-click": "settings"
    },
    "custom/terminal": {
      "format": "\uf120",
      "tooltip": "Terminal",
      "on-click": "foot"
    }
  }
]